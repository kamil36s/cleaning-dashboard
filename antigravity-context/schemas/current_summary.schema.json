{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/antigravity-context/schemas/current_summary.schema.json",
  "title": "Current Summary",
  "description": "Cross-dataset deterministic signal candidates and freshness.",
  "type": "object",
  "required": [
    "dataset",
    "schema_version",
    "generated_at",
    "source_freshness",
    "dataset_freshness",
    "deterministic_signals"
  ],
  "properties": {
    "dataset": {
      "const": "current_summary"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC export timestamp."
    },
    "source_freshness": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Newest source file modification time; not necessarily observation time."
    },
    "dataset_freshness": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "deterministic_signals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
