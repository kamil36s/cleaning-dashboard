<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0F1511</item>
        <item name="android:navigationBarColor">#0F1511</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#0F1511</item>
        <item name="android:colorAccent">#AAD1A9</item>
    </style>
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#EEF3EB</item>
    </style>
</resources>
