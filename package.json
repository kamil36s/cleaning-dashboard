    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "moment": "^2.30.1",
    "nanoid": "^3.3.11",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.6",
    "rollup": "^4.52.5",
    "source-map-js": "^1.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "vis-timeline": "^8.5.2"
  },
