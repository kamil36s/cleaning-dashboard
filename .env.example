# Journal HTR is opt-in. Keep real tokens in .env.development or .env.production.
HTR_ENABLED=false
HTR_PROVIDER=escriptorium
ESCRIPTORIUM_BASE_URL=http://127.0.0.1:8081
ESCRIPTORIUM_API_TOKEN=
ESCRIPTORIUM_PROJECT_SLUG=
ESCRIPTORIUM_MAIN_SCRIPT=Latin
HTR_STORAGE_PATH=
HTR_MAX_UPLOAD_MB=25
HTR_TRAINING_MIN_LINES=200
HTR_RETRAIN_AFTER_NEW_LINES=300
LASTFM_USERNAME=your-lastfm-username
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_SHARED_SECRET=your-lastfm-shared-secret
LASTFM_SYNC_INTERVAL_MINUTES=30
DASHBOARD_HOST=127.0.0.1
DASHBOARD_WRITE_TOKEN=replace-with-a-random-secret
DASHBOARD_HABITS_TOKEN=replace-with-a-random-secret
DASHBOARD_FEELINGS_TOKEN=replace-with-a-random-secret
# Independent Live Workout process. Use 0.0.0.0 only when a watch/LAN client
# must post telemetry directly; remote writes require one of the tokens below.
TRAINING_RUNTIME_HOST=127.0.0.1
TRAINING_RUNTIME_PORT=8766
TRAINING_RUNTIME_ALLOWED_ORIGINS=
DASHBOARD_LIVE_WORKOUT_TOKEN=replace-with-a-random-secret
# Optional AnkiConnect key; kept server-side and never returned by Language APIs.
LANGUAGE_ANKI_CONNECT_API_KEY=
# Optional server-side locations for the independent, rebuildable Language reference domain.
LANGUAGE_REFERENCE_DB=
LANGUAGE_REFERENCE_SOURCE_DIR=
# Server-side Google Cloud TTS (Application Default Credentials/service-account JSON).
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
NORWEGIAN_TTS_VOICE=nb-NO-Chirp3-HD-Kore
# Phase 8 generation is opt-in and deliberately refuses non-free policy/model fallbacks.
LANGUAGE_GEMINI_ENABLED=false
LANGUAGE_GEMINI_MODE=FREE_ONLY
LANGUAGE_GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Job Hunt Pack F AI extraction is opt-in. Provider/model/endpoint are backend-owned.
JOBHUNT_AI_ENABLED=false
JOBHUNT_AI_PROVIDER=gemini
JOBHUNT_AI_MODEL=gemini-3.8-flash
JOBHUNT_AI_TIMEOUT_SECONDS=45
JOBHUNT_AI_MAX_SOURCE_CHARS=60000
JOBHUNT_AI_MAX_CONTEXT_FACTS=100
JOBHUNT_AI_MAX_OUTPUT_TOKENS=4096
JOBHUNT_AI_MAX_RETRIES=1
JOBHUNT_AI_DAILY_CALL_LIMIT=0
JOBHUNT_AI_DAILY_TOKEN_LIMIT=0
# Optional versioned local price metadata; leave blank to show tokens without a cost estimate.
JOBHUNT_AI_PRICE_VERSION=
JOBHUNT_AI_INPUT_USD_PER_MILLION_TOKENS=
JOBHUNT_AI_OUTPUT_USD_PER_MILLION_TOKENS=
JOBHUNT_AI_CACHED_USD_PER_MILLION_TOKENS=
# Job Hunt Pack G NAV collection is explicit opt-in. The Bearer token stays backend-only.
JOBHUNT_NAV_ENABLED=false
JOBHUNT_NAV_TOKEN=
JOBHUNT_NAV_TIMEOUT_SECONDS=20
JOBHUNT_NAV_POLL_SECONDS=120
JOBHUNT_NAV_BOOTSTRAP_DAYS=185
JOBHUNT_NAV_DETAIL_BUDGET=100
# Optional AI follow-up after deterministic extraction; off by default for cost/privacy safety.
JOBHUNT_NAV_AUTO_AI=false
# Job Hunt Pack I Pracuj.pl collection reads a dedicated mailbox/folder over
# TLS-only IMAP. Credentials remain backend-only and the source is opt-in.
JOBHUNT_PRACUJ_ENABLED=false
JOBHUNT_PRACUJ_IMAP_HOST=
JOBHUNT_PRACUJ_IMAP_PORT=993
JOBHUNT_PRACUJ_IMAP_USER=
JOBHUNT_PRACUJ_IMAP_PASSWORD=
JOBHUNT_PRACUJ_MAILBOX=INBOX
JOBHUNT_PRACUJ_IMAP_TIMEOUT_SECONDS=30
JOBHUNT_PRACUJ_POLL_SECONDS=300
JOBHUNT_PRACUJ_BOOTSTRAP_DAYS=30
JOBHUNT_PRACUJ_BOOTSTRAP_MAX_MESSAGES=500
# Pack L1 Jobbnorge uses the unauthenticated official Public API only.
# Collection is disabled until enabled here or in the local Ingestion workspace.
JOBHUNT_JOBBNORGE_ENABLED=false
JOBHUNT_JOBBNORGE_TIMEOUT_SECONDS=20
JOBHUNT_JOBBNORGE_POLL_SECONDS=1800
JOBHUNT_JOBBNORGE_REQUEST_BUDGET=12
JOBHUNT_JOBBNORGE_PAGE_SIZE=50
JOBHUNT_JOBBNORGE_MAX_PAGES=3
JOBHUNT_JOBBNORGE_JOB_BUDGET=300
JOBHUNT_JOBBNORGE_MAX_RESPONSE_BYTES=1048576
JOBHUNT_JOBBNORGE_CYCLE_BYTE_BUDGET=4194304
VITE_WEATHER_LATITUDE=50.0614
# Music metadata worker; set to false to leave the catalog and existing artwork unchanged.
MUSIC_ENRICHMENT_ENABLED=true
# Set a contact address in this User-Agent before a large MusicBrainz backfill.
MUSIC_METADATA_USER_AGENT=CleaningDashboard-Music/1.0 (contact: your-email@example.com)
# Optional providers. Without a key they are skipped; MusicBrainz, CAA, Wikidata,
# Wikimedia Commons and Apple do not require credentials.
MUSIC_DISCOGS_TOKEN=
MUSIC_AUDIODB_KEY=
# Optional per-provider controls: MUSIC_MUSICBRAINZ_ENABLED=false,
# MUSIC_MUSICBRAINZ_INTERVAL=1.15, MUSIC_MUSICBRAINZ_TIMEOUT=15.
VITE_WEATHER_LONGITUDE=19.9366
WEATHER_LATITUDE=50.0614
WEATHER_LONGITUDE=19.9366
